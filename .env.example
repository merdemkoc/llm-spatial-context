# Copy to `.env` (gitignored) and fill in. The server reads these; nothing is shipped to the browser.

# Anthropic API key — the observer that interprets spatial change.
ANTHROPIC_API_KEY=

# OpenAI API key — the text-to-speech voice.
OPENAI_API_KEY=

# Optional. Reasoning model for the observer (one-line swap: try claude-haiku-4-5 or claude-opus-5).
OBSERVER_MODEL=claude-sonnet-5

# Optional. Reasoning model for the grouping suggester. Falls back to OBSERVER_MODEL, then the default.
SUGGESTER_MODEL=claude-sonnet-5

# Optional. Reasoning model for the whole-board reflection. Falls back to OBSERVER_MODEL, then the default.
REFLECT_MODEL=claude-sonnet-5

# Optional. Reasoning model for the board digest. Falls back to OBSERVER_MODEL, then the default.
DIGEST_MODEL=claude-sonnet-5

# Optional. Reasoning effort for the observer (low, medium, high, xhigh, max). Unset means the
# API's own default, which is what normal operation uses; `npm run eval` sets it to compare.
OBSERVER_EFFORT=

# Optional. OpenAI TTS voice for gpt-4o-mini-tts (alloy, echo, fable, onyx, nova, shimmer, …).
TTS_VOICE=alloy

# Optional. Port for the standalone server (must match the Vite dev proxy target).
PORT=8787
