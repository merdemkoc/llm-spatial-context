{
	"name": "llm-spatial-context",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
		"dev:web": "vite --host",
		"dev:api": "tsx watch server/index.ts",
		"build": "tsc && tsc -p tsconfig.server.json && vite build",
		"preview": "vite preview",
		"start": "tsx server/index.ts",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.116.0",
		"@hono/node-server": "^2.1.0",
		"hono": "^4.13.1",
		"openai": "^7.4.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"tldraw": "^5.3.0",
		"tsx": "^4.23.12"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^10.0.4",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.9.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	}
}
